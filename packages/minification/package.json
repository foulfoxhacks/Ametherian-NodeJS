{
  "name": "@foulfoxhacks/ametherian-minification",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded, adapter-driven JavaScript and CSS minification orchestration for Ametherian. Unpublished preview.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./javascript": {
      "types": "./src/index.d.ts",
      "default": "./src/javascript/index.js"
    },
    "./cascade": {
      "types": "./src/index.d.ts",
      "default": "./src/cascade/index.js"
    }
  },
  "files": [
    "src",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@foulfoxhacks/ametherian-core": "0.1.0"
  }
}
